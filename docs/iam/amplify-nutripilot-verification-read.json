{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLambdaLayers",
      "Effect": "Allow",
      "Action": ["lambda:ListLayers"],
      "Resource": "*"
    },
    {
      "Sid": "ReadNutriPilotLayerVersions",
      "Effect": "Allow",
      "Action": ["lambda:GetLayerVersion"],
      "Resource": "arn:aws:lambda:us-east-1:880079111164:layer:*:*"
    },
    {
      "Sid": "ReadApiGatewayConfiguration",
      "Effect": "Allow",
      "Action": ["apigateway:GET"],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/restapis",
        "arn:aws:apigateway:us-east-1::/restapis/*"
      ]
    }
  ]
}
